# Telegram Bot
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tg_bot

# YuKassa
YUKASSA_SHOP_ID=your_shop_id
YUKASSA_SECRET_KEY=your_secret_key

# Channel/Group ID (negative number, e.g. -1001234567890)
CHANNEL_ID=-100xxxxxxxxxx

# Comma-separated Telegram user IDs of admins
ADMIN_IDS=123456789

# Telegram username of support manager (without @)
SUPPORT_USERNAME=your_manager_username

# Payment webhook server port
WEBHOOK_PORT=8080

# Public URL of your server (used for YuKassa return_url)
BASE_URL=https://your-domain.com

# Test mode (set to 'true' to enable test mode with 10 rubles for all plans)
TEST_MODE=false
